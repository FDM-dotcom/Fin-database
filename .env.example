# Database
POSTGRES_DB=findb
POSTGRES_USER=finuser
POSTGRES_PASSWORD=change_me_strong_password

# pgAdmin (web UI op poort 5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin_password

# Alembic / API connection string (lokaal)
DATABASE_URL=postgresql://finuser:change_me_strong_password@localhost:5432/findb

# Frontend API URL — vul in met het IP van je server als je van een ander apparaat werkt
# Op dezelfde machine: http://localhost:8000
# Via netwerk: http://<server-ip>:8000
VITE_API_URL=http://localhost:8000
